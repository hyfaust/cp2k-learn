&GLOBAL
  PROJECT  Si_bulk8_metal
  RUN_TYPE ENERGY_FORCE
  PRINT_LEVEL LOW
&END GLOBAL

&FORCE_EVAL
  METHOD  QS

  &DFT
    BASIS_SET_FILE_NAME  BASIS_SET
    POTENTIAL_FILE_NAME  GTH_POTENTIALS

    &MGRID
      CUTOFF  300
      REL_CUTOFF  60
    &END MGRID

    &QS
      EPS_DEFAULT  1.0E-10
    &END QS

    &SCF
      SCF_GUESS  ATOMIC
      EPS_SCF  1.0E-6
      MAX_SCF  100
      ADDED_MOS  10

      &SMEAR
        METHOD  FERMI_DIRAC
        ELECTRONIC_TEMPERATURE  300
      &END SMEAR

      &DIAGONALIZATION
      &END DIAGONALIZATION

      &MIXING
        METHOD  BROYDEN_MIXING
        ALPHA  0.4
        NBUFFER  7
      &END MIXING

    &END SCF

    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT

  &SUBSYS
    &CELL
      ABC  5.4306975  5.4306975  5.4306975
      PERIODIC  XYZ
    &END CELL

    &KIND Si
      BASIS_SET  DZVP-GTH-PADE
      POTENTIAL  GTH-PADE-q4
    &END KIND

    &COORD
      Si   0.000000   0.000000   0.000000
      Si   1.357674   1.357674   1.357674
      Si   2.715349   2.715349   0.000000
      Si   4.073023   4.073023   1.357674
      Si   2.715349   0.000000   2.715349
      Si   4.073023   1.357674   4.073023
      Si   0.000000   2.715349   2.715349
      Si   1.357674   4.073023   4.073023
    &END COORD
  &END SUBSYS
&END FORCE_EVAL
